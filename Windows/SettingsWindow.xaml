<Window x:Class="SmoothTabTransition.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smooth Tab Transition"
        Width="520" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <!-- Modern Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- Track background -->
                            <Border Height="8" 
                                    Background="#25FFFFFF" 
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Margin="0"/>
                            
                            <!-- Track fill (progress) -->
                            <Border x:Name="TrackFill"
                                    Height="8" 
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6C5CE7" Offset="0"/>
                                        <GradientStop Color="#A29BFE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            
                            <Track x:Name="PART_Track" Margin="0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb" Width="24" Height="24" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <!-- Outer glow -->
                                                    <Ellipse Width="24" Height="24" Fill="#6C5CE7" Opacity="0.3">
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="8"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- Main thumb -->
                                                    <Ellipse x:Name="ThumbEllipse" Width="20" Height="20" Fill="White">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" 
                                                                              Direction="270" Color="#000000" Opacity="0.3"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- Inner dot -->
                                                    <Ellipse Width="8" Height="8" Fill="#6C5CE7"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbEllipse" Property="Width" Value="22"/>
                                                        <Setter TargetName="ThumbEllipse" Property="Height" Value="22"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border x:Name="SwitchBorder"
                                    Width="52" Height="28"
                                    Background="#30FFFFFF"
                                    CornerRadius="14"
                                    Cursor="Hand">
                                <Grid>
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="22" Height="22"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             Margin="3,0,0,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#000000" Opacity="0.25"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            
                            <ContentPresenter Grid.Column="1" 
                                              Margin="14,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6C5CE7" Offset="0"/>
                                            <GradientStop Color="#A29BFE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#6C5CE7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6C5CE7" Offset="0"/>
                                    <GradientStop Color="#8B7CF7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7D6EF0" Offset="0"/>
                                            <GradientStop Color="#9B8CF9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5B4BD6" Offset="0"/>
                                            <GradientStop Color="#7B6CF0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#50FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="WindowShadow" 
                          BlurRadius="50" 
                          ShadowDepth="0" 
                          Direction="0" 
                          Color="#000000" 
                          Opacity="0.7"/>
    </Window.Resources>
    
    <Border CornerRadius="20" 
            Effect="{StaticResource WindowShadow}"
            BorderBrush="#20FFFFFF"
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8101018" Offset="0"/>
                <GradientStop Color="#F8181822" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Settings" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="White"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Customize your window switcher" 
                               FontSize="14" 
                               Foreground="#70FFFFFF"
                               Margin="0,6,0,0"
                               FontFamily="Segoe UI"/>
                </StackPanel>
                
                <!-- Close button -->
                <Button Grid.Column="1" 
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Cursor="Hand"
                        VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="#15FFFFFF" 
                                    CornerRadius="10">
                                <TextBlock Text="✕" 
                                           FontSize="16" 
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            
            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Animations Section -->
                    <TextBlock Text="ANIMATIONS" 
                               FontSize="11" 
                               FontWeight="Bold"
                               Foreground="#6C5CE7"
                               Margin="0,0,0,14"
                               FontFamily="Segoe UI"/>
                    
                    <Border Background="#12FFFFFF" CornerRadius="16" Padding="22" Margin="0,0,0,24">
                        <StackPanel>
                            <CheckBox x:Name="AnimationsCheckBox" 
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="True"
                                      Margin="0,0,0,24">
                                <TextBlock Text="Enable Animations" 
                                           Foreground="White" 
                                           FontSize="15"
                                           FontFamily="Segoe UI"/>
                            </CheckBox>
                            
                            <!-- Animation Speed -->
                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Animation Speed" 
                                           Foreground="#CCFFFFFF" 
                                           FontSize="14"
                                           FontFamily="Segoe UI"/>
                                <Border Grid.Column="1" 
                                        Background="#20FFFFFF" 
                                        CornerRadius="8" 
                                        Padding="12,6">
                                    <TextBlock x:Name="SpeedValue"
                                               Text="0.20s" 
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI Semibold"/>
                                </Border>
                                
                                <Slider x:Name="SpeedSlider" 
                                        Grid.Row="1" Grid.ColumnSpan="2"
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="0.05" Maximum="0.5" Value="0.2"
                                        Margin="0,8,0,0"/>
                            </Grid>
                            
                            <!-- Hover Scale -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Hover Scale Effect" 
                                           Foreground="#CCFFFFFF" 
                                           FontSize="14"
                                           FontFamily="Segoe UI"/>
                                <Border Grid.Column="1" 
                                        Background="#20FFFFFF" 
                                        CornerRadius="8" 
                                        Padding="12,6">
                                    <TextBlock x:Name="ScaleValue"
                                               Text="108%" 
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI Semibold"/>
                                </Border>
                                
                                <Slider x:Name="ScaleSlider" 
                                        Grid.Row="1" Grid.ColumnSpan="2"
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="1.0" Maximum="1.2" Value="1.08"
                                        Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Appearance Section -->
                    <TextBlock Text="APPEARANCE" 
                               FontSize="11" 
                               FontWeight="Bold"
                               Foreground="#6C5CE7"
                               Margin="0,0,0,14"
                               FontFamily="Segoe UI"/>
                    
                    <Border Background="#12FFFFFF" CornerRadius="16" Padding="22" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Accent Color" 
                                       Foreground="#CCFFFFFF" 
                                       FontSize="14"
                                       Margin="0,0,0,14"
                                       FontFamily="Segoe UI"/>
                            <WrapPanel Margin="0,0,0,20">
                                <Border x:Name="Color1" Width="42" Height="42" CornerRadius="12" 
                                        Background="#6C5CE7" Margin="0,0,12,12" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPreset_Click" Tag="#6C5CE7"
                                        BorderThickness="3" BorderBrush="Transparent"/>
                                <Border x:Name="Color2" Width="42" Height="42" CornerRadius="12" 
                                        Background="#4A9EFF" Margin="0,0,12,12" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPreset_Click" Tag="#4A9EFF"
                                        BorderThickness="3" BorderBrush="Transparent"/>
                                <Border x:Name="Color3" Width="42" Height="42" CornerRadius="12" 
                                        Background="#00D9A5" Margin="0,0,12,12" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPreset_Click" Tag="#00D9A5"
                                        BorderThickness="3" BorderBrush="Transparent"/>
                                <Border x:Name="Color4" Width="42" Height="42" CornerRadius="12" 
                                        Background="#FF6B6B" Margin="0,0,12,12" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPreset_Click" Tag="#FF6B6B"
                                        BorderThickness="3" BorderBrush="Transparent"/>
                                <Border x:Name="Color5" Width="42" Height="42" CornerRadius="12" 
                                        Background="#FFB347" Margin="0,0,12,12" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPreset_Click" Tag="#FFB347"
                                        BorderThickness="3" BorderBrush="Transparent"/>
                                <Border x:Name="Color6" Width="42" Height="42" CornerRadius="12" 
                                        Background="#FF69B4" Margin="0,0,12,12" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPreset_Click" Tag="#FF69B4"
                                        BorderThickness="3" BorderBrush="Transparent"/>
                            </WrapPanel>
                            
                            <!-- Max Windows -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Max Windows to Display" 
                                           Foreground="#CCFFFFFF" 
                                           FontSize="14"
                                           FontFamily="Segoe UI"/>
                                <Border Grid.Column="1" 
                                        Background="#20FFFFFF" 
                                        CornerRadius="8" 
                                        Padding="12,6">
                                    <TextBlock x:Name="MaxWindowsValue"
                                               Text="12" 
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI Semibold"/>
                                </Border>
                                
                                <Slider x:Name="MaxWindowsSlider" 
                                        Grid.Row="1" Grid.ColumnSpan="2"
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="6" Maximum="30" Value="20"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Info Section -->
                    <Border Background="#08FFFFFF" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Keyboard Shortcuts" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,16"
                                       FontFamily="Segoe UI"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#20FFFFFF" CornerRadius="8" Padding="12,7" Margin="0,0,14,0">
                                    <TextBlock Text="Alt + Tab" FontSize="12" Foreground="White" 
                                               FontFamily="Segoe UI Semibold" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Open window switcher" Foreground="#70FFFFFF" 
                                           FontSize="13" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#20FFFFFF" CornerRadius="8" Padding="12,7" Margin="0,0,14,0">
                                    <TextBlock Text="Alt + Shift + Tab" FontSize="12" Foreground="White" 
                                               FontFamily="Segoe UI Semibold" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Navigate backwards" Foreground="#70FFFFFF" 
                                           FontSize="13" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="v1.0" 
                           Foreground="#40FFFFFF" 
                           FontSize="12"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"/>
                
                <Button Grid.Column="1" 
                        Content="Reset" 
                        Style="{StaticResource SecondaryButton}"
                        Click="ResetButton_Click"
                        Margin="0,0,12,0"/>
                
                <Button Grid.Column="2" 
                        Content="Save &amp; Close" 
                        Style="{StaticResource ModernButton}"
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
