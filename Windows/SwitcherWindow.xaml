<Window x:Class="SmoothTabTransition.Windows.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Switcher"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowState="Maximized"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#6C5CE7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F0181820"/>
        
        <!-- Fade in -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetName="MainGrid"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                           Storyboard.TargetProperty="ScaleX"
                           From="0.95" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                           Storyboard.TargetProperty="ScaleY"
                           From="0.95" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HintText"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"
                           BeginTime="0:0:0.1"/>
        </Storyboard>
        
        <!-- Fade out -->
        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetName="MainGrid"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                           Storyboard.TargetProperty="ScaleX"
                           To="0.97" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                           Storyboard.TargetProperty="ScaleY"
                           To="0.97" Duration="0:0:0.12"/>
        </Storyboard>
        
        <!-- Card shadow -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="20" 
                          ShadowDepth="4" 
                          Direction="270" 
                          Color="#000000" 
                          Opacity="0.6"/>
    </Window.Resources>
    
    <Grid x:Name="MainGrid" Opacity="0" Focusable="True" KeyDown="Window_KeyDown">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid.RenderTransformOrigin>
            <Point X="0.5" Y="0.5"/>
        </Grid.RenderTransformOrigin>
        
        <!-- Center content container -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="#E8101014"
                CornerRadius="16"
                Padding="20"
                MaxWidth="1600"
                MaxHeight="900">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Windows grid -->
                <ItemsControl x:Name="WindowsContainer" 
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="WindowBorder"
                                   Margin="6"
                                   Padding="6"
                                   Background="{DynamicResource CardBackgroundBrush}"
                                   BorderBrush="Transparent"
                                   BorderThickness="2"
                                   CornerRadius="10"
                                   Cursor="Hand"
                                   Width="280"
                                   Effect="{StaticResource CardShadow}"
                                   MouseEnter="WindowItem_MouseEnter"
                                   MouseLeave="WindowItem_MouseLeave"
                                   MouseLeftButtonUp="WindowItem_MouseLeftButtonUp">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0" Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>
                                    <Point X="0.5" Y="0.5"/>
                                </Border.RenderTransformOrigin>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0"
                                            Background="#FF050508" 
                                            CornerRadius="6" 
                                            Height="158"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" 
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    
                                    <!-- Window info -->
                                    <StackPanel Grid.Row="1" Margin="4,8,4,2">
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="#EEFFFFFF"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   MaxWidth="260"
                                                   FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding ProcessName}" 
                                                   FontSize="9"
                                                   Foreground="#66FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Hint text -->
                <Border x:Name="HintText" 
                        Grid.Row="1" 
                        Opacity="0"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Release " FontSize="12" Foreground="#66FFFFFF" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2" Margin="2,0">
                            <TextBlock Text="Alt" FontSize="11" Foreground="#CCFFFFFF" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text=" to switch  •  " FontSize="12" Foreground="#66FFFFFF" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2" Margin="2,0">
                            <TextBlock Text="Tab" FontSize="11" Foreground="#CCFFFFFF" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text=" next  •  " FontSize="12" Foreground="#66FFFFFF" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,2" Margin="2,0">
                            <TextBlock Text="Esc" FontSize="11" Foreground="#CCFFFFFF" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text=" cancel" FontSize="12" Foreground="#66FFFFFF" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
